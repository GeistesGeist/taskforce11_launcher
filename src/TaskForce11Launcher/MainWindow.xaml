<Window x:Class="TaskForce11Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:TaskForce11Launcher.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TaskForce11 Launcher"
        Icon="Assets/app.ico"
        Height="680" Width="960"
        MinHeight="560" MinWidth="820"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        KeyDown="OnWindowKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <conv:ModStatusToBrushConverter x:Key="StatusToBrush" />
        <conv:NullableBoolToStatusBrushConverter x:Key="ServerStatusToBrush" />

        <Style x:Key="ModListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowChrome" Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter Margin="8,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowChrome" Property="Background" Value="#12FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
        <Grid>
            <!-- Ebene 0: das Hintergrundbild, randlos und unscharfgestellt ueber das
                 gesamte Fenster einschliesslich der Titelleiste. -->
            <Grid ClipToBounds="True">
                <Rectangle Fill="{StaticResource FallbackBackgroundBrush}" />
                <Image Source="{Binding BackgroundImageSource}" Stretch="UniformToFill" />
                <Rectangle Fill="{StaticResource DarkenOverlayBrush}" />
            </Grid>

            <!-- Ebene 1: Bedienelemente, transparent, damit das Bild durchscheint -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Titelleiste: links der Launcher-Name, rechts Steam-Profil,
                     Einstellungen und die Fensterknoepfe. -->
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Image Source="Assets/app.ico" Width="16" Height="16" />
                        <TextBlock Text="TASKFORCE11 LAUNCHER" Margin="8,0,0,0" FontSize="15"
                                   FontFamily="{StaticResource HeadingFont}"
                                   Foreground="#B5AEA0" VerticalAlignment="Center"
                                   Effect="{StaticResource TextOutlineEffect}" />
                        <TextBlock Text="{Binding AppVersion}" Margin="6,1,0,0" FontSize="10"
                                   Foreground="{StaticResource MutedBrush}" Opacity="0.55" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,4,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource PanelStrokeBrush}" BorderThickness="1">
                            <Border CornerRadius="12" Margin="1" ClipToBounds="True">
                                <Image Source="{Binding SteamAvatar}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </Border>
                        <TextBlock Text="{Binding SteamUserName, TargetNullValue='Nicht verbunden'}" FontSize="12"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                   Margin="8,0,0,0" MaxWidth="150" TextTrimming="CharacterEllipsis" />
                        <Button Content="&#9881;" ToolTip="Einstellungen" Click="OnOpenSettingsClick"
                                Style="{StaticResource IconButtonStyle}" Width="28" Height="28" FontSize="14" Margin="10,0,4,0" />
                        <Border Width="1" Height="20" Background="{StaticResource PanelBorderBrush}" Margin="6,0" />
                        <Button Content="&#9472;" Click="OnMinimizeClick" Style="{StaticResource TitleBarButtonStyle}" Height="40" />
                        <Button Content="&#9744;" Click="OnMaximizeRestoreClick" Style="{StaticResource TitleBarButtonStyle}" Height="40" />
                        <Button Content="&#10005;" Click="OnCloseClick" Style="{StaticResource TitleBarCloseButtonStyle}" Height="40" />
                    </StackPanel>
                </Grid>

                <!-- Inhalt: das Wappen mittig auf dem Bild, darunter eine einzige
                     Kommandoleiste mit Serverstatus, Mods, Fortschritt und START.
                     Modliste und Verlauf klappen bei Bedarf als Schublade auf, statt
                     das Fenster dauerhaft zu teilen. -->
                <Grid Grid.Row="1" Margin="24,4,24,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Das Wappen wächst mit dem Fenster: die obere Zeile bekommt allen
                         übrigen Platz, und das Bild füllt sie proportional aus. Nach oben
                         begrenzt MaxHeight, damit es im Vollbild nicht ausufert, nach
                         unten schrumpft es einfach mit. Zuvor stand es fest auf 184
                         Pixeln und blieb dadurch auch im Vollbild briefmarkengroß. -->
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Image Grid.Row="0" Stretch="Uniform" MaxHeight="400" MinHeight="96"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="0,8,0,0" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Source>
                                <!-- Reicht für 400 Punkte auch bei 200 % Anzeigeskalierung. -->
                                <BitmapImage UriSource="Assets/logo.png" DecodePixelWidth="800" />
                            </Image.Source>
                        </Image>

                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,14,0,0">
                            <TextBlock Text="T A S K   F O R C E   1 1" FontSize="54"
                                       FontFamily="{StaticResource HeadingFont}"
                                       Foreground="#FFFFFF" HorizontalAlignment="Center"
                                       Effect="{StaticResource HeroTextOutlineEffect}" />
                            <Border Width="340" Height="1" Background="{StaticResource FadeDividerBrush}"
                                    Margin="0,12,0,12" HorizontalAlignment="Center" />

                            <!-- Deutlich groesser als der uebrige Kleintext: Bebas Neue laeuft
                                 sehr schmal, in kleinen Graden draengen sich die Buchstaben
                                 dieser langen Zeile so eng, dass sie kaum noch zu entziffern
                                 ist. Zusammen mit der Sperrung durch Leerzeichen und dem
                                 kraeftigeren Saum wird daraus eine ruhig lesbare Zeile. -->
                            <TextBlock Text="K O M M A N D O   S P E Z I A L K R Ä F T E   D E R   M A R I N E"
                                       FontSize="23" FontFamily="{StaticResource HeadingFont}"
                                       Foreground="#F2EEE5" HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="620"
                                       Effect="{StaticResource HeroTextOutlineEffect}" />
                        </StackPanel>
                    </Grid>

                    <!-- Kommandoleiste -->
                    <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Padding="20,14" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                             Fill="{Binding Arma3ServerOnline, Converter={StaticResource ServerStatusToBrush}}" />
                                    <TextBlock Text="Arma" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                               Margin="6,0,0,0" VerticalAlignment="Center" />
                                    <!-- Ohne Sichtbarkeitsbindung: die Zahl steht von Anfang an
                                         da, vor der ersten Abfrage als Strichpaar. -->
                                    <TextBlock Text="{Binding Arma3PlayerCount, StringFormat='({0})'}" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}" Opacity="0.7"
                                               Margin="4,0,0,0" VerticalAlignment="Center" />

                                    <!-- Der TS-Status haengt an TeamspeakOnline, nicht an der
                                         Adresse: ohne hinterlegten ServerQuery-Zugang wird nie
                                         geprueft, der Wert bleibt null und hier steht dann gar
                                         nichts - besser als ein grauer Punkt, der wie "offline"
                                         oder "laedt noch" aussieht. Sobald Zugangsdaten in
                                         serverdata.json stehen, erscheint die Anzeige von selbst. -->
                                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0"
                                                ToolTip="{Binding TeamspeakHost}"
                                                Visibility="{Binding TeamspeakOnline, Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                                        <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                 Fill="{Binding TeamspeakOnline, Converter={StaticResource ServerStatusToBrush}}" />
                                        <TextBlock Text="TS" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding TeamspeakUserCount, StringFormat='({0})'}" FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}" Opacity="0.7"
                                                   Margin="4,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding TeamspeakUserCount, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{Binding MissionTime}" FontSize="10" Foreground="{StaticResource MutedBrush}"
                                           Opacity="0.65" Margin="12,2,0,0" ToolTip="Nächster Missionstermin"
                                           Visibility="{Binding MissionTime, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />
                            </StackPanel>

                            <Border Grid.Column="1" Width="1" Background="{StaticResource PanelBorderBrush}" Margin="18,2" />

                            <!-- Oeffnet die Schublade auf der Modliste -->
                            <Button Grid.Column="2" Click="OnModsChipClick" Style="{StaticResource GhostButtonStyle}"
                                    Padding="14,9" VerticalAlignment="Center" ToolTip="Modliste anzeigen">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="MODS" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                    <Border CornerRadius="2" Background="#1AFFFFFF" Padding="6,1" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Mods.Count}" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <Button Content="&#128337;" ToolTip="Verlauf" Click="OnHistoryClick"
                                        Style="{StaticResource IconButtonStyle}" Width="36" Height="36" FontSize="14" Margin="6,0,0,0" />
                                <Button ToolTip="Mit dem TeamSpeak-Server verbinden"
                                        Command="{Binding ConnectTeamspeakCommand}"
                                        Style="{StaticResource IconButtonStyle}" Width="36" Height="36" Margin="2,0,0,0"
                                        Visibility="{Binding TeamspeakHost, Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                                    <Image Source="Assets/teamspeak.png" Width="19" Height="19"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Button>
                            </StackPanel>

                            <Border Grid.Column="4" Width="1" Background="{StaticResource PanelBorderBrush}" Margin="18,2" />

                            <!-- Liegt ein Update bereit, sitzt der Hinweis in der sonst
                                 leeren Dehnspalte - sichtbar, aber ohne den START-Knopf
                                 zu verdraengen. -->
                            <Button Grid.Column="5" Command="{Binding RestartToUpdateCommand}"
                                    Style="{StaticResource GhostButtonStyle}" Padding="12,7" Margin="0,0,16,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    ToolTip="Launcher neu starten und Update übernehmen"
                                    Visibility="{Binding AvailableUpdateVersion, Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{StaticResource OkBrush}" />
                                    <TextBlock Text="{Binding AvailableUpdateVersion, StringFormat='Update {0} bereit'}"
                                               FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                               Margin="7,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Text="— neu starten" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                               Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <StackPanel Grid.Column="6" Orientation="Vertical" VerticalAlignment="Center"
                                        MaxWidth="260" Margin="0,0,16,0">
                                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <ProgressBar IsIndeterminate="{Binding IsBusy}" Height="3" Margin="0,4,0,0"
                                             Visibility="{Binding IsBusy, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                            </StackPanel>

                            <!-- Unmittelbar neben START: hier faellt die Entscheidung, ob mit
                                 oder ohne Serververbindung gestartet wird, und genau hier
                                 schaut man kurz vorher hin. -->
                            <CheckBox Grid.Column="7" Content="Server beitreten" IsChecked="{Binding ConnectToServer}"
                                      VerticalAlignment="Center" Margin="0,0,18,0"
                                      ToolTip="Aus: Arma 3 startet mit allen Mods, aber ins Hauptmenü statt auf den Server" />

                            <!-- Ohne Leuchteffekt: der glomm im Akzentrot und passt nicht mehr
                                 zur gedeckten Fuellung des Knopfes. -->
                            <Button Grid.Column="8" Content="{Binding StartButtonLabel}" Command="{Binding PrepareAndLaunchCommand}"
                                    IsEnabled="{Binding CanLaunch}"
                                    FontSize="16" Padding="34,10" />
                        </Grid>
                    </Border>

                    <!-- Abdunkelung hinter der Schublade; faengt auch Klicks daneben ab, um
                         sie zu schliessen. Der negative Rand hebt die Einrueckung des
                         Elternrasters auf, damit sie bis an die Fensterkanten reicht. -->
                    <Border x:Name="DrawerScrim" Grid.RowSpan="2" Margin="-24,-4,-24,-24" Background="#9105070A"
                            Visibility="Collapsed" Opacity="0" MouseLeftButtonUp="OnScrimClick" />

                    <Border x:Name="DrawerPanel" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                            Width="430" Style="{StaticResource PanelStyle}"
                            Visibility="Collapsed" Opacity="0" RenderTransformOrigin="1,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="16,14,10,8">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="ModsTabChrome" Background="{StaticResource TabActiveBrush}" CornerRadius="2"
                                            Padding="12,6" Cursor="Hand" MouseLeftButtonUp="OnModsTabClick">
                                        <TextBlock x:Name="ModsTabLabel" Text="MODS" FontSize="13" FontFamily="{StaticResource HeadingFont}"
                                                   Foreground="{StaticResource AccentBrightBrush}" />
                                    </Border>
                                    <Border x:Name="LogTabChrome" Background="Transparent" CornerRadius="2" Padding="12,6"
                                            Margin="4,0,0,0" Cursor="Hand" MouseLeftButtonUp="OnLogTabClick">
                                        <TextBlock x:Name="LogTabLabel" Text="VERLAUF" FontSize="13" FontFamily="{StaticResource HeadingFont}"
                                                   Foreground="{StaticResource MutedBrush}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Prüfen" Command="{Binding CheckAndSubscribeModsCommand}"
                                            Style="{StaticResource GhostButtonStyle}" FontSize="10" Padding="10,5" Margin="0,0,6,0"
                                            ToolTip="Modliste neu laden und fehlende Mods abonnieren"
                                            IsEnabled="{Binding IsBusy, Converter={x:Static conv:InverseBoolConverter.Instance}}" />
                                    <Button Content="&#10005;" Style="{StaticResource IconButtonStyle}" Click="OnCloseDrawerClick" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Height="1" Background="{StaticResource AccentHairlineBrush}" Margin="16,0,16,10" />

                            <Grid Grid.Row="2">
                                <Grid x:Name="ModsTabContent" Margin="10,0,10,14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Aus welchem Preset die geladene Liste stammt - macht
                                         sofort sichtbar, ob jemand noch auf einem alten
                                         Stand haengt. -->
                                    <TextBlock Grid.Row="0" Text="{Binding ModlistLabel}" FontSize="10"
                                               Foreground="{StaticResource MutedBrush}" Opacity="0.75" Margin="8,0,6,8"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding ModlistLabel, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />

                                    <ListBox Grid.Row="1" ItemsSource="{Binding Mods}" Background="Transparent" BorderThickness="0"
                                             ItemContainerStyle="{StaticResource ModListBoxItemStyle}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="3" CornerRadius="0" Margin="0,0,10,0"
                                                            Background="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                                    <!-- Der Tooltip zeigt den vollen Namen: in der schmalen
                                                         Schublade werden laengere Modnamen abgeschnitten. -->
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Name}" />
                                                    <Border Grid.Column="2" CornerRadius="2" Padding="8,2" Margin="10,0,4,0"
                                                            Background="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=Subtle}">
                                                        <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                                    </Border>
                                                    <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Content="&#8635;"
                                                            ToolTip="Mod löschen und neu herunterladen"
                                                            Command="{Binding DataContext.RedownloadModCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding DataContext.CanLaunch, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>

                                <Grid x:Name="LogTabContent" Margin="16,0,16,14" Visibility="Collapsed">
                                    <TextBox x:Name="LogTextBox" Text="{Binding LogText, Mode=OneWay}" TextChanged="OnLogTextChanged"
                                             IsReadOnly="True" IsUndoEnabled="False" TextWrapping="Wrap"
                                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}"
                                             FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
