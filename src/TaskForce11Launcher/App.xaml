<Application x:Class="TaskForce11Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Farbwelt der Einheitsverwaltung (Panel.TaskForce11.de): ein warmes, fast
                 schwarzes Braun als Grund, Rot als einziger Akzent, Raender in gedecktem
                 Oliv. Alles bewusst flach und kantig - keine Glasflaechen, keine grossen
                 Radien, keine tiefen Schatten. Das Panel wirkt wie ein Einsatzterminal,
                 und der Launcher soll daneben nicht wie ein anderes Programm aussehen. -->
            <SolidColorBrush x:Key="BackgroundBrush" Color="#100E0C" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#2E2A22" />
            <SolidColorBrush x:Key="AccentBrush" Color="#C43D2E" />
            <SolidColorBrush x:Key="AccentBrightBrush" Color="#E05A46" />
            <SolidColorBrush x:Key="AccentHairlineBrush" Color="#59C43D2E" />
            <SolidColorBrush x:Key="TextBrush" Color="#CFCABF" />
            <SolidColorBrush x:Key="MutedBrush" Color="#8A8377" />
            <SolidColorBrush x:Key="OkBrush" Color="#7A8C4F" />
            <SolidColorBrush x:Key="WarnBrush" Color="#B8873A" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#A33224" />

            <!-- Steht, bis das Hintergrundbild aus serverdata.json geladen ist. Warme,
                 sehr dunkle Toene statt eines neutralen Grauverlaufs. -->
            <LinearGradientBrush x:Key="FallbackBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#12100D" Offset="0" />
                <GradientStop Color="#1B1815" Offset="0.5" />
                <GradientStop Color="#0D0B09" Offset="1" />
            </LinearGradientBrush>

            <!-- Dunkelt oben und unten ab, wo Text sitzt; die Mitte bleibt fast klar. -->
            <LinearGradientBrush x:Key="DarkenOverlayBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#8C100E0C" Offset="0" />
                <GradientStop Color="#1A100E0C" Offset="0.24" />
                <GradientStop Color="#1A100E0C" Offset="0.66" />
                <GradientStop Color="#73100E0C" Offset="1" />
            </LinearGradientBrush>

            <!-- Panelfuellung: fast deckend und praktisch einfarbig - im Panel sind die
                 Karten flache Kaesten, kein Verlauf und kein Lichtstreif. -->
            <SolidColorBrush x:Key="PanelBrush" Color="#F21A1714" />

            <SolidColorBrush x:Key="PanelStrokeBrush" Color="#332F27" />

            <!-- Fuellung der Handlungsknoepfe (START, Speichern, Bestaetigen). Gedecktes
                 Olivbraun statt des Akzentrots; Rot bleibt damit den Markierungen und
                 aktiven Elementen vorbehalten. Die Zustaende darunter sind Aufhellungen
                 und Abdunklungen desselben Tons - mit dem alten roten Hover wuerde der
                 Knopf beim Ueberfahren die Farbe wechseln statt nur heller zu werden. -->
            <SolidColorBrush x:Key="AccentCtaBrush" Color="#34302A" />
            <SolidColorBrush x:Key="AccentCtaHoverBrush" Color="#474137" />
            <SolidColorBrush x:Key="AccentCtaPressedBrush" Color="#26231E" />

            <!-- Auslaufende Trennlinie unter dem Einheitsnamen. -->
            <LinearGradientBrush x:Key="FadeDividerBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00C43D2E" Offset="0" />
                <GradientStop Color="#8CC96A5B" Offset="0.5" />
                <GradientStop Color="#00C43D2E" Offset="1" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="TabActiveBrush" Color="#2EC43D2E" />

            <!-- Legt sich in den kleineren Fenstern ueber das Hintergrundbild.
                 Bewusst nur ein Hauch: das Bild der Einheit hat eine mittlere Helligkeit
                 von rund 18 von 255 und ist damit praktisch schwarz. Eine kraeftige
                 Abdunklung - anfangs lagen hier 87 % - loescht es vollstaendig aus, statt
                 nur seine Spitzen zu daempfen. Fuer die Lesbarkeit braucht es sie auch
                 nicht: Text in #CFCABF steht darauf mit weit ueber dem geforderten
                 Kontrast. -->
            <SolidColorBrush x:Key="DialogScrimBrush" Color="#38151210" />

            <!-- Deutlich flacher als zuvor: eine leichte Absetzung nach unten, kein
                 schwebender Schlagschatten. -->
            <DropShadowEffect x:Key="CardShadowEffect" Color="#000000" Direction="270" BlurRadius="14" ShadowDepth="3" Opacity="0.5" />
            <DropShadowEffect x:Key="AccentGlowEffect" Color="#C43D2E" BlurRadius="14" ShadowDepth="0" Opacity="0.4" />

            <!-- Enger, fast deckender schwarzer Saum fuer Text direkt auf dem Bild. -->
            <DropShadowEffect x:Key="TextOutlineEffect" Color="#000000" BlurRadius="5" ShadowDepth="0" Opacity="0.95" />

            <!-- Fuer die beiden grossen Schriftzuege ueber dem Hintergrundbild. Bebas Neue
                 laeuft schmal und mit duennen Strichen; auf unruhigem Grund verliert sie
                 ohne kraeftigen Saum ihre Kanten. Deutlich weiter gezogen und voll deckend,
                 damit die Buchstaben sich klar gegen das Bild absetzen. -->
            <DropShadowEffect x:Key="HeroTextOutlineEffect" Color="#000000" BlurRadius="12" ShadowDepth="0" Opacity="1" />

            <Style x:Key="PanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource PanelStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="Effect" Value="{StaticResource CardShadowEffect}" />
            </Style>

            <!-- Bebas Neue, mitgeliefert unter Assets\Fonts. Dieselbe Schrift verwendet
                 die Einheitsverwaltung fuer ihre Ueberschriften. Sie kennt nur
                 Grossbuchstaben und ist schmal geschnitten - fuer Ueberschriften genau
                 richtig, fuer Fliesstext nicht, der bleibt bei Segoe UI.
                 Die Schreibweise "Ordner/#Familienname" ist Pflicht; ohne das Doppelkreuz
                 findet WPF die eingebettete Schrift nicht und faellt stillschweigend auf
                 eine Ersatzschrift zurueck. -->
            <FontFamily x:Key="HeadingFont">pack://application:,,,/Assets/Fonts/#Bebas Neue</FontFamily>

            <!-- Abschnittsueberschrift im Panel-Stil: in Versalien, leicht gesperrt.
                 WPF kennt keinen Zeichenabstand - die Sperrung entsteht dort, wo der Text
                 gesetzt wird, durch eingefuegte Leerzeichen. -->
            <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentCtaBrush}" />
                <Setter Property="Foreground" Value="#F5F0E8" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <!-- Feine Kante: die Fuellung liegt farblich nah am Panel, ohne
                                 Rand verschwaemme der Knopf mit dem Untergrund. -->
                            <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}"
                                    BorderBrush="#4E4739" BorderThickness="1"
                                    CornerRadius="2" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Aufhellen statt vergroessern: das Panel arbeitet ohne
                                     Bewegung, ein hüpfender Knopf faellt daneben auf. -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource AccentCtaHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource AccentCtaPressedBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.4" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Sekundaerer Knopf: nur ein Rahmen, bis er ueberfahren wird. -->
            <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="GhostChrome" Background="#14000000" BorderBrush="{StaticResource PanelBorderBrush}"
                                    BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="GhostChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="GhostChrome" Property="Background" Value="#1FC43D2E" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Kaestchen im Panel-Stil: kantig, dunkel, mit rotem Haken - so wie die
                 Ausbildungslisten in der Einheitsverwaltung. Das Standardelement von WPF
                 bringt einen hellen Windows-Kasten mit und faellt hier heraus. -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="Box" Width="14" Height="14" CornerRadius="2"
                                        Background="#42000000" BorderBrush="{StaticResource PanelBorderBrush}"
                                        BorderThickness="1" VerticalAlignment="Center">
                                    <!-- Haken als Strichzug statt als Schriftzeichen: ein Haken
                                         aus der Schrift saesse je nach Schriftart anders im
                                         Kaestchen und liesse sich nicht sauber zentrieren. -->
                                    <Path x:Name="Check" Data="M 2,6 L 5,9.5 L 11,2.5" Stroke="{StaticResource AccentBrush}"
                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter x:Name="Label" Margin="8,0,0,0" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrightBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ProgressBar">
                <Setter Property="Background" Value="#26000000" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!-- Kleiner Knopf nur mit Symbol, z. B. der Neu-laden-Knopf je Mod. -->
            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="#1FC43D2E" />
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrightBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Titelleiste: die native Fensterdekoration ist per WindowChrome ersetzt. -->
            <Style x:Key="TitleBarButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="40" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="#1FFFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="#F5F0E8" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Schmale, randlose Bildlaufleisten ohne Pfeilknoepfe. -->
            <Style x:Key="ThemeScrollBarThumb" TargetType="Thumb">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="{StaticResource PanelBorderBrush}" CornerRadius="1" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Width" Value="10" />
                <Setter Property="MinWidth" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ThemeScrollBarThumb}" Width="6" Margin="2,0" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Height" Value="10" />
                        <Setter Property="MinHeight" Value="10" />
                        <Setter Property="Width" Value="Auto" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="{TemplateBinding Background}">
                                        <Track x:Name="PART_Track" IsDirectionReversed="False" Orientation="Horizontal">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" />
                                            </Track.DecreaseRepeatButton>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" />
                                            </Track.IncreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource ThemeScrollBarThumb}" Height="6" Margin="0,2" />
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
