<Application x:Class="TaskForce11Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Farbwelt von taskforce11.de: fast schwarzer Grund, Graustufen fuer Text,
                 und als einziger echter Farbakzent das gedeckte Stahlblau #698EAE der
                 Website. Bewusst zurueckhaltend - eine KSK-Einheit traegt kein Neon. -->
            <SolidColorBrush x:Key="BackgroundBrush" Color="#08090B" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="AccentBrush" Color="#698EAE" />
            <SolidColorBrush x:Key="AccentBrightBrush" Color="#9FBBD2" />
            <SolidColorBrush x:Key="AccentHairlineBrush" Color="#40698EAE" />
            <SolidColorBrush x:Key="TextBrush" Color="#E6E6E6" />
            <SolidColorBrush x:Key="MutedBrush" Color="#8F8F8F" />
            <SolidColorBrush x:Key="OkBrush" Color="#4A873B" />
            <SolidColorBrush x:Key="WarnBrush" Color="#C08A34" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#8B2929" />

            <!-- Steht, bis das Hintergrundbild aus serverdata.json geladen ist. -->
            <LinearGradientBrush x:Key="FallbackBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B0D10" Offset="0" />
                <GradientStop Color="#15191F" Offset="0.5" />
                <GradientStop Color="#08090B" Offset="1" />
            </LinearGradientBrush>

            <!-- Dunkelt nur dort ab, wo Text sitzt (oben Titelleiste, unten Kommandoleiste);
                 die Mitte bleibt fast klar, damit das Bild lesbar bleibt. -->
            <LinearGradientBrush x:Key="DarkenOverlayBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#8A08090B" Offset="0" />
                <GradientStop Color="#1A08090B" Offset="0.24" />
                <GradientStop Color="#1A08090B" Offset="0.66" />
                <GradientStop Color="#7008090B" Offset="1" />
            </LinearGradientBrush>

            <!-- Panel-Fuellung: ein feiner Lichtstreif oben links, der in einen fast
                 deckenden dunklen Ton laeuft - genug Kontrast, damit Text auch ueber
                 unruhigem Bildmaterial lesbar bleibt. -->
            <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#12FFFFFF" Offset="0" />
                <GradientStop Color="#07FFFFFF" Offset="0.2" />
                <GradientStop Color="#EE070809" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="PanelStrokeBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#59FFFFFF" Offset="0" />
                <GradientStop Color="#1FFFFFFF" Offset="0.5" />
                <GradientStop Color="#12FFFFFF" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="AccentCtaBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#4E6E8A" Offset="0" />
                <GradientStop Color="#7B9EBC" Offset="1" />
            </LinearGradientBrush>

            <!-- Auslaufende Trennlinie unter dem Einheitsnamen. -->
            <LinearGradientBrush x:Key="FadeDividerBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00698EAE" Offset="0" />
                <GradientStop Color="#73A9C4DA" Offset="0.5" />
                <GradientStop Color="#00698EAE" Offset="1" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="TabActiveBrush" Color="#26698EAE" />

            <DropShadowEffect x:Key="CardShadowEffect" Color="#000000" Direction="270" BlurRadius="26" ShadowDepth="8" Opacity="0.42" />
            <DropShadowEffect x:Key="AccentGlowEffect" Color="#9FBBD2" BlurRadius="18" ShadowDepth="0" Opacity="0.45" />

            <!-- Enger, fast deckender schwarzer Saum fuer Text, der ohne Panel direkt auf
                 dem Bild sitzt - liest sich als Kontur, nicht als Weichzeichner. -->
            <DropShadowEffect x:Key="TextOutlineEffect" Color="#000000" BlurRadius="5" ShadowDepth="0" Opacity="0.95" />

            <Style x:Key="PanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource PanelStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Effect" Value="{StaticResource CardShadowEffect}" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentCtaBrush}" />
                <Setter Property="Foreground" Value="#08090B" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ButtonChrome" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.02" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.02" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ButtonChrome" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Sekundaerer Knopf: transparent, bis er ueberfahren wird. -->
            <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="GhostChrome" Background="Transparent" BorderBrush="{StaticResource PanelBorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="GhostChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="GhostChrome" Property="Background" Value="#12FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ProgressBar">
                <Setter Property="Background" Value="#1AFFFFFF" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!-- Kleiner Knopf nur mit Symbol, z. B. der Neu-laden-Knopf je Mod. -->
            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="#1FFFFFFF" />
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrightBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Titelleiste: die native Fensterdekoration ist per WindowChrome ersetzt. -->
            <Style x:Key="TitleBarButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="40" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="#1AFFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ErrorBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Schmale, randlose Bildlaufleisten ohne Pfeilknoepfe - die Standard-Leiste
                 von Windows wuerde in diesem Fenster wie ein Fremdkoerper wirken. -->
            <Style x:Key="ThemeScrollBarThumb" TargetType="Thumb">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="{StaticResource PanelBorderBrush}" CornerRadius="3" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Width" Value="10" />
                <Setter Property="MinWidth" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ThemeScrollBarThumb}" Width="6" Margin="2,0" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Height" Value="10" />
                        <Setter Property="MinHeight" Value="10" />
                        <Setter Property="Width" Value="Auto" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="{TemplateBinding Background}">
                                        <Track x:Name="PART_Track" IsDirectionReversed="False" Orientation="Horizontal">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" />
                                            </Track.DecreaseRepeatButton>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" />
                                            </Track.IncreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource ThemeScrollBarThumb}" Height="6" Margin="0,2" />
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
