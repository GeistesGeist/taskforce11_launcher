<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <AssemblyName>TaskForce11Launcher</AssemblyName>
    <RootNamespace>TaskForce11Launcher</RootNamespace>
    <Product>TaskForce11 Launcher</Product>
    <Company>Task Force 11</Company>
    <Version>0.1.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Ohne das haengt das SDK "+<git-sha>" an die InformationalVersion - genau den
         Wert liest das Versionslabel in der Titelleiste, und mit SHA ist er zu lang. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="steam_appid.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="steam_api64.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="config\default-config.json" CopyToOutputDirectory="PreserveNewest" />
    <None Remove="Assets\logo.png" />
    <None Remove="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\teamspeak.png" />

    <!-- Eingebettet, weil Bebas Neue auf keinem Windows vorinstalliert ist. Ohne das
         faende WPF sie auf den Rechnern der Mitglieder nicht und fiele stillschweigend
         auf eine Ersatzschrift zurueck. Die Lizenz (SIL Open Font License) liegt daneben
         und wird mitgeliefert, wie sie es verlangt. -->
    <Resource Include="Assets\Fonts\BebasNeue-Regular.ttf" />

    <!-- Die Lizenz kommt als Datei neben die EXE, nicht in sie hinein: die Open Font
         License verlangt, dass sie mit der Schrift weitergegeben wird, und in einer
         eingebetteten Ressource kaeme niemand an sie heran. -->
    <None Include="Assets\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
