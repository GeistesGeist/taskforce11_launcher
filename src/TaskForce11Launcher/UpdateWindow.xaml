<Window x:Class="TaskForce11Launcher.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Force 11 Launcher"
        Icon="Assets/app.ico"
        Height="240" Width="420"
        Background="Transparent"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">
    <Border CornerRadius="3" Background="{StaticResource FallbackBackgroundBrush}"
            BorderBrush="{StaticResource PanelStrokeBrush}" BorderThickness="1">
        <Grid Margin="28,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                <Image Width="44" Height="44" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Source>
                        <BitmapImage UriSource="Assets/logo.png" DecodePixelWidth="128" />
                    </Image.Source>
                </Image>
                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="TASK FORCE 11" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="Launcher" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1" Height="1" Background="{StaticResource FadeDividerBrush}"
                    VerticalAlignment="Top" Margin="0,20,0,0" />

            <StackPanel Grid.Row="2">
                <TextBlock x:Name="StatusLabel" Text="Suche nach Updates…" FontSize="12"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           HorizontalAlignment="Center" TextAlignment="Center" MinHeight="34" />
                <ProgressBar x:Name="Progress" Height="4" Margin="0,12,0,0" IsIndeterminate="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
