<Window x:Class="TaskForce11Launcher.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskForce11 Launcher"
        Icon="Assets/app.ico"
        Height="272" Width="460"
        Background="Transparent"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">

    <!-- Aufgebaut wie eine Karte der Einheitsverwaltung: flacher, fast schwarzer
         Kasten mit duennem Rand, oben die Kennung, darunter ein gesperrter
         Abschnittskopf ueber einer Trennlinie, und der Wert als Zeile aus Label
         links und Angabe rechts. -->
    <Border CornerRadius="2" Background="{StaticResource FallbackBackgroundBrush}"
            BorderBrush="{StaticResource PanelStrokeBrush}" BorderThickness="1">
        <Grid>
            <!-- Dasselbe Hintergrundbild wie im Hauptfenster, aus dem lokalen
                 Zwischenspeicher. Beim allerersten Start liegt dort noch nichts -
                 dann bleibt der Farbverlauf stehen. -->
            <Grid x:Name="BackgroundLayer">
                <Rectangle Fill="{StaticResource DialogScrimBrush}" />
            </Grid>

        <Grid Margin="26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Image Width="40" Height="40" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Source>
                        <BitmapImage UriSource="Assets/logo.png" DecodePixelWidth="128" />
                    </Image.Source>
                </Image>
                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="T A S K  F O R C E  1 1" FontSize="19" FontFamily="{StaticResource HeadingFont}"
                               Foreground="{StaticResource TextBrush}" />
                    <!-- Gesperrt und heller als der uebrige Kleintext: Bebas Neue in
                         kleinen Graden und gedaempftem Grau war hier kaum zu lesen. -->
                    <TextBlock Text="L A U N C H E R" FontSize="15" FontFamily="{StaticResource HeadingFont}"
                               Foreground="#B5AEA0" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1" Height="1" Background="{StaticResource PanelBorderBrush}" Margin="0,18,0,0" />

            <TextBlock Grid.Row="2" Text="A K T U A L I S I E R U N G" FontSize="14" FontFamily="{StaticResource HeadingFont}"
                       Foreground="{StaticResource AccentBrush}" Margin="0,16,0,0" />

            <!-- Label links, Angabe rechts - das Zeilenmuster der Panel-Karten -->
            <Grid Grid.Row="3" VerticalAlignment="Center" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="STATUS" FontSize="12" FontFamily="{StaticResource HeadingFont}" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Top" Margin="0,1,14,0" />
                <TextBlock x:Name="StatusLabel" Grid.Column="1" Text="Suche nach Updates…" FontSize="12"
                           Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
            </Grid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar x:Name="Progress" Grid.Column="0" Height="3" IsIndeterminate="True"
                             VerticalAlignment="Center" />
                <TextBlock x:Name="PercentLabel" Grid.Column="1" Text="" FontSize="10"
                           Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0"
                           VerticalAlignment="Center" MinWidth="34" TextAlignment="Right" />
            </Grid>
        </Grid>
        </Grid>
    </Border>
</Window>
